      var zones = ["Original","0%","5%","10%","15%","20%","25%","30%"];
      i = 0;
      while(i < 8) { result.push({title:names[i],id:2300+this._profile*8+i,choices:i<2?strengths:(i<4?["Off","On"]:(i<6?zones:["Original","Precise","Fast"]))}); i++; }
