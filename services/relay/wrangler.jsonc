{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beetleworx-relay",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RelayRoom" },
      { "name": "ADMISSION", "class_name": "Admission" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelayRoom", "Admission"] }
  ],
  "observability": { "enabled": false }
}
